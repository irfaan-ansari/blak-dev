{
  "name": "@blak/auth",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/auth-client.d.ts",
      "import": "./dist/auth-client.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "generate": "pnpm dlx auth generate --config ./src/auth.ts --yes"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.1",
    "@blak/db": "workspace:*",
    "@blak/utils": "workspace:*",
    "@blak/email": "workspace:*",
    "better-auth": "^1.6.20",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@blak/ts-config": "workspace:*",
    "@types/node": "^26.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
