{
  "extends": "@blak/ts-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@blak/auth/*": ["./src/*"]
    }
  },

  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
