{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    "types": ["node"],

    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "@/*": ["./src/*"]
    },

    "noEmit": true
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
