{
  "extends": "@blak/ts-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",

    "types": ["node"],

    "rootDir": "src",
    "outDir": "dist",

    "declaration": true,
    "declarationMap": true
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
