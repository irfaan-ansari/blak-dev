model Country {
    id String @id @default(cuid())

    name String
    iso2 String  @unique // IN, AE, US
    iso3 String? @unique // IND, ARE, USA

    phoneCode String? // +91, +971, +1

    currencyId String
    currency   Currency @relation(fields: [currencyId], references: [id])

    states State[]
    cities City[]

    markets Market[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("country")
}

model State {
    id String @id @default(cuid())

    countryId String
    country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

    name String
    code String
    type String?

    cities  City[]
    markets MarketState[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    taxRules  TaxRule[]

    @@unique([countryId, code])
    @@unique([id, countryId])
    @@index([countryId])
    @@map("state")
}

model City {
    id       String @id @default(cuid())
    name     String
    timezone String

    countryId String
    country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

    stateId String?
    state   State?  @relation(fields: [stateId], references: [id])

    markets MarketCity[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([id, countryId])
    @@map("city")
}

model Currency {
    id String @id @default(cuid())

    code        String  @unique // ISO 4217 alpha, e.g. "INR"
    numericCode String? @unique // ISO 4217 numeric, e.g. "356" — some banking/compliance systems require this
    name        String
    symbol      String

    symbolPosition SymbolPosition @default(PREFIX)
    decimals       Int            @default(2) // JPY=0, BHD=3, most others=2

    markets   Market[]
    countries Country[]
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    @@map("currency")
}

model Market {
    id   String @id @default(cuid())
    name String
    iso2 String @unique

    countryId String  @unique
    country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

    scope        MarketScope  @default(COUNTRY)
    distanceUnit DistanceUnit @default(KM)

    timezone  String
    locale    String?
    status    MarketStatus @default(DRAFT)
    createdAt DateTime     @default(now())
    updatedAt DateTime     @updatedAt

    currencyId String
    currency   Currency @relation(fields: [currencyId], references: [id])

    states                 MarketState[]
    cities                 MarketCity[]
    organizations          Organization[]
    serviceAreas           ServiceArea[]
    applications           Application[]
    taxRules               TaxRule[]
    complianceRequirements ComplianceRequirement[]

    @@unique([id, countryId])
    @@index([status])
    @@map("market")
}

model MarketState {
    marketId  String
    stateId   String
    countryId String

    market Market @relation(fields: [marketId, countryId], references: [id, countryId], onDelete: Cascade)
    state  State  @relation(fields: [stateId, countryId], references: [id, countryId], onDelete: Cascade)

    @@id([marketId, stateId])
    @@unique([stateId])
    @@index([stateId])
    @@index([countryId])
    @@map("market_state")
}

model MarketCity {
    marketId  String
    cityId    String
    countryId String

    market Market @relation(fields: [marketId, countryId], references: [id, countryId], onDelete: Cascade)
    city   City   @relation(fields: [cityId, countryId], references: [id, countryId], onDelete: Cascade)

    @@id([marketId, cityId])
    @@unique([cityId])
    @@index([cityId])
    @@index([countryId])
    @@map("market_city")
}

model ServiceArea {
    id       String @id @default(cuid())
    marketId String
    market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

    name     String
    boundary Json // GeoJSON polygon
    isActive Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("service_area")
}

model TaxRule {
    id       String @id @default(cuid())
    marketId String
    market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

    stateId String? // null = applies market-wide
    state   State?  @relation(fields: [stateId], references: [id])

    name          String // "VAT", "GST", "Sales Tax"
    rate          Decimal   @db.Decimal(6, 4)
    effectiveFrom DateTime
    effectiveTo   DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([marketId, effectiveFrom])
    @@map("tax_rule")
}

model ComplianceRequirement {
    id String @id @default(cuid())

    marketId String
    market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

    entityType EntityType

    name  String
    label String
    type  ComplianceType

    isRequired Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    records ComplianceRecord[]

    @@unique([marketId, entityType, name])
    @@index([marketId, entityType])
    @@map("compliance_requirement")
}

model ComplianceRecord {
    id String @id @default(cuid())

    requirementId String
    requirement   ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

    entityType EntityType
    entityId   String

    value String?

    documentId String?
    document   Document? @relation(fields: [documentId], references: [id])

    status String @default("PENDING")

    expiresAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([entityType, entityId])
    @@index([requirementId])
    @@map("compliance_record")
}
