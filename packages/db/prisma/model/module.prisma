model Application {
    id                  String               @id @default(cuid())
    type                EntityType
    currentStatus       ApplicationStatus    @default(PENDING_APPROVAL)
    marketId            String?
    market              Market?              @relation(fields: [marketId], references: [id], onDelete: Restrict)
    organizationId      String?              @unique
    organization        Organization?        @relation(fields: [organizationId], references: [id])
    contactName         String
    contactPhone        String
    contactEmail        String
    contactTitle        String
    submittedAt         DateTime?
    decidedAt           DateTime?
    rejectionReason     String?
    invitationId        String?              @unique
    operatorApplication OperatorApplication?
    partnerApplication  PartnerApplication?
    createdAt           DateTime             @default(now())
    updatedAt           DateTime             @updatedAt

    @@index([currentStatus])
    @@index([type])
    @@index([marketId])
    @@map("application")
}

model OperatorApplication {
    id                          String      @id @default(cuid())
    applicationId               String      @unique
    application                 Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
    legalBusinessName           String
    operatingName               String?
    businessType                String
    website                     String?
    businessEmail               String
    businessPhone               String
    address                     String
    city                        String
    state                       String
    pincode                     String
    country                     String
    commerciallyLicensedInsured Boolean
    operatesLuxurySedansSuvs    Boolean
    yearsInOperation            Int
    operatingMarkets            String[]
    vehicleCount                Int
    chauffeurCount              Int?
    serviceTypes                String[]
    createdAt                   DateTime    @default(now())
    updatedAt                   DateTime    @updatedAt

    @@map("operator_application")
}

model PartnerApplication {
    id                     String      @id @default(cuid())
    applicationId          String      @unique
    application            Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
    legalBusinessName      String
    operatingName          String?
    businessType           String
    website                String?
    businessEmail          String
    businessPhone          String
    address                String
    city                   String
    state                  String
    pincode                String
    country                String
    propertiesRooms        String
    monthlyBookings        String?
    currentTransportation  String
    transportationDetails  String?
    transportationServices String[]
    partnershipUses        String[]
    additionalInformation  String?
    acknowledgedAt         DateTime
    createdAt              DateTime    @default(now())
    updatedAt              DateTime    @updatedAt

    @@map("partner_application")
}

model Vehicle {
    id                 String          @id @default(cuid())
    year               Int
    make               String
    model              String
    trim               String
    interiorColor              String
    exteriorColor              String
    engine String
    licensePlate       String          @unique
    registrationNumber String?         @unique
    vin                String?         @unique
    registrationExpiry DateTime?
    category           VehicleCategory
    status             VehicleStatus   @default(PENDING_APPROVAL)
    organizationId     String
    organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    driverId           String?         @unique
    driver             User?           @relation(fields: [driverId], references: [id], onDelete: SetNull)
    createdAt          DateTime        @default(now())
    updatedAt          DateTime        @updatedAt

    @@index([organizationId])
    @@index([status])
    @@map("vehicles")
}

model Review {
    id         String       @id @default(cuid())
    entityType ReviewEntity
    entityId   String
    status     ReviewStatus @default(PENDING_APPROVAL)
    reason     String?
    reviewerId String?
    reviewer   User?        @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
    reviewedAt DateTime?
    createdAt  DateTime     @default(now())
    updatedAt  DateTime     @updatedAt

    @@index([entityType, entityId])
    @@index([status])
    @@map("review")
}

model File {
    id                String             @id @default(cuid())
    name              String
    mime              String
    size              BigInt
    storageKey        String             @unique
    url               String?

    createdAt         DateTime           @default(now())
    updatedAt         DateTime           @updatedAt

    complianceRecords ComplianceRecord[]
    attachments       EntityAttachment[]

    @@map("file")
}

model EntityAttachment {
    id         String   @id @default(cuid())

    fileId     String
    file       File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

    entityType EntityType
    entityId   String

    name String
    label String

    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([entityType, entityId])
    @@index([fileId])

    @@map("entity_attachment")
}